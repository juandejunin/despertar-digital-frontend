---
import Footer from "../components/Footer.astro";
import InfoBar from "../components/InfoBar.astro";
import NavBar from "../components/NavBar.astro";
import CookieConsent from "../CookieConsent";
import "../styles/global.css";
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" sizes="any">

    <title>Despertar Digital</title>
    <meta
      name="description"
      content="Solo datos, sin relatos. Noticias automatizadas y objetivas."
    />

    <slot name="head" />

    <!-- ===================== -->
    <!-- Google Analytics + Consent Mode (SAFE ORDER) -->
    <!-- ===================== -->

    <!-- 1️⃣ Definición global de dataLayer y gtag -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      // Consentimiento por defecto: TODO DENEGADO
      window.gtag("consent", "default", {
        analytics_storage: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        wait_for_update: 800,
      });
    </script>

    <!-- 2️⃣ Carga de Google Analytics (async, sin riesgo) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XX7WSF51QK"
    ></script>

    <!-- 3️⃣ Activación SOLO si ya hubo consentimiento -->
    <script is:inline>
      const consent = localStorage.getItem("cookieConsent");

      if (consent === "all") {
        window.gtag("js", new Date());
        window.gtag("config", "G-XX7WSF51QK");
      }
    </script>
  </head>

  <body
    class="h-full min-h-screen flex flex-col overflow-y-scroll font-serifSystem text-gray-900 bg-gray-300"
  >
    <!-- Banner de cookies -->
    <CookieConsent client:load />

    <!-- NavBar (fijo arriba) -->
    <div class="fixed top-0 left-0 w-full z-50">
      <NavBar />
    </div>

    <!-- InfoBar (debajo del nav) -->
    <div class="fixed top-20 left-0 w-full z-40">
      <!-- top-20 ≈ NavBar (72px) -->
      <InfoBar lastUpdate="12:27" />
    </div>

    <!-- ===================== -->
    <!-- CONTENIDO PRINCIPAL -->
    <!-- ===================== -->
    <main class="flex-1 pt-32">
      <!-- pt-32 = NavBar + InfoBar + margen -->
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
