---
import Footer from "../components/Footer.astro";
import InfoBar from "../components/InfoBar.astro";
import NavBar from "../components/NavBar.astro";
import "../styles/global.css";
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Despertar Digital</title>
    <meta
      name="description"
      content="Solo datos, sin relatos. Noticias automatizadas y objetivas."
    />
    <slot name="head" />
  </head>
  <body class="font-serifSystem text-gray-900  min-h-screen flex flex-col bg-gray-300">
    
    <!-- === CABECERA FIJA === -->
    <!-- NavBar (fijo arriba) -->
    <div class="fixed top-0 left-0 w-full z-50">
      <NavBar />
    </div>

    <!-- InfoBar (fijo debajo del nav) -->
    <div class="fixed top-20 left-0 w-full z-40"> <!-- top-20 = 80px (NavBar ~72px) -->
      <InfoBar lastUpdate="12:27" />
    </div>

    <!-- === CONTENIDO PRINCIPAL === -->
    <main class="flex-1 pt-32"> <!-- 128px = NavBar (72) + InfoBar (~40) + margen -->
      <slot />
    </main>

    <!-- === FOOTER === -->
    <Footer />
  </body>
</html>