---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<article
  class="bg-white border border-gray-100
         rounded-xl shadow-md
         flex flex-col w-full max-w-md min-h-[360px]
         hover:shadow-lg transition-shadow"
>
  <!-- Header -->
  <header class="p-5 pb-3">
    <h3 class="text-lg font-bold text-gray-800">
      {title}
    </h3>

    {subtitle && (
      <p class="text-xs text-gray-500 mt-1">
        {subtitle}
      </p>
    )}
  </header>

  <!-- Body -->
  <section class="flex-1 px-5">
    <slot />
  </section>

  <!-- Footer / Action -->
  <footer class="p-5 pt-4">
    <slot name="action" />
  </footer>
</article>
