---
import type { CryptoData } from "../types/crypto";

const { data } = Astro.props as { data: CryptoData };

const isUp = data.change24h >= 0;
const changeColor = isUp ? "text-green-600" : "text-red-600";
const arrow = isUp ? "↑" : "↓";
---

<a
  href={`/economia/criptomonedas/${data.id}`}
  class="bg-white shadow-md rounded-lg p-4 flex flex-col items-center text-center
         hover:shadow-xl transition-shadow"
>
  <img src={data.image} alt={data.name} class="w-16 h-16 mb-2" />

  <h2 class="font-bold text-lg">
    {data.name} ({data.symbol})
  </h2>

  <p class="text-xl font-semibold mt-1">
    ${data.price.toLocaleString()}
  </p>

  <p class={`${changeColor} font-bold mt-1`}>
    {arrow} {data.change24h.toFixed(2)}%
  </p>

  <p class="text-sm text-gray-500 mt-2">
    Volumen 24h: ${data.volume24h.toLocaleString()}
  </p>
</a>
