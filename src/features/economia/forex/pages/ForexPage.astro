---
import Layout from "@/layouts/Layout.astro";
import ForexTable from "../components/ForexTable.astro";
import { getForexTrends } from "../services/getForexTrends";

let forexData = null;
let error: string | null = null;

try {
  forexData = await getForexTrends();
} catch (err) {
  console.error(err);
  error = "No se pudo cargar la información de Forex";
}
---

<Layout title="Forex - Despertar Digital">
  <header class="text-center space-y-2 px-4">
    <h1 class="text-3xl sm:text-4xl font-bold">Mercado Forex</h1>
    <p class="text-gray-600 max-w-2xl mx-auto text-sm sm:text-base">
      Todas las monedas se comparan contra el
      <strong>dólar estadounidense (USD)</strong>.
      La tabla muestra la tendencia en distintos horizontes temporales.
    </p>
  </header>

  <section
    class="
      mt-8
      px-2 sm:px-4 md:px-6
      w-full max-w-5xl mx-auto
      flex justify-center
    "
  >
    {error ? (
      <div class="bg-red-100 text-red-700 p-3 rounded">{error}</div>
    ) : (
      <div class="w-full flex justify-center overflow-x-auto">
        <ForexTable trends={forexData?.trends ?? []} />
      </div>
    )}
  </section>
</Layout>
