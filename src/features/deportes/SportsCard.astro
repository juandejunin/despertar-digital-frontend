---
// DeportesCard.astro
const API_URL = import.meta.env.PUBLIC_DEPORTES_API_URL;
---

<div
  id="deportes-card"
  class="bg-white rounded-xl shadow-md p-5 border border-gray-100
         hover:shadow-lg transition-shadow cursor-pointer
         flex flex-col justify-between w-full max-w-md min-h-[360px]"
  data-api-url={API_URL}
>
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-gray-800">Deportes</h3>
    <span
      id="deportes-time"
      class="text-xs text-gray-500 font-medium tracking-wide"
    >
      Cargando…
    </span>
  </div>

  <div
    id="deportes-content"
    class="flex-1 flex flex-col justify-center items-center text-center"
  >
    <div class="animate-pulse space-y-2 w-full">
      <div class="h-7 bg-gray-100 rounded-lg w-10/12 mx-auto"></div>
      <div class="h-7 bg-gray-100 rounded-lg w-9/12 mx-auto"></div>
    </div>
  </div>

  <p class="text-[10px] text-gray-400 text-center mt-2 select-none">
    Click para siguiente · Shift + Click para anterior
  </p>
</div>

<script type="module">
  const card = document.getElementById("deportes-card");
  const API_URL = card?.dataset.apiUrl;
  const content = document.getElementById("deportes-content");
  const timeEl = document.getElementById("deportes-time");

  /** @typedef {{ league: string; home: string; away: string; homeGoals: number; awayGoals: number; status: string; time: string }} Match */

  if (!API_URL || !content) throw new Error("API_URL o contenido no definido");

  let matches = [];
  let currentIndex = 0;
  let intervalId = null;
  const CACHE_TTL_MS = 5 * 60 * 1000;
  const cacheKey = "sports-matches";

  const readCache = () => {
    const raw = sessionStorage.getItem(cacheKey);
    if (!raw) return null;
    try {
      const { ts, data } = JSON.parse(raw);
      if (Date.now() - ts < CACHE_TTL_MS) return data;
    } catch {}
    return null;
  };

  const writeCache = (data) => {
    sessionStorage.setItem(cacheKey, JSON.stringify({ ts: Date.now(), data }));
  };

  const fetchWithTimeout = (url, opts = {}, timeoutMs = 8000) => {
    const controller = new AbortController();
    const id = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(url, { ...opts, signal: controller.signal }).finally(() =>
      clearTimeout(id),
    );
  };

  /** @param {Match} match */
  const renderMatch = (match) => {
    if (!content) return;
    content.innerHTML = `
    <div class="p-4 rounded-lg bg-gray-50 flex flex-col justify-between w-full h-40 sm:h-44">
      <!-- Liga -->
      <p class="text-xs text-blue-600 font-medium text-center truncate mb-1" title="${match.league}">
        ${match.league}
      </p>

      <!-- Equipo local -->
      <p class="text-sm font-semibold text-gray-700 truncate text-center" title="${match.home}">
        ${match.home}
      </p>

      <!-- Marcador -->
      <p class="text-lg font-bold text-gray-900 text-center">
        ${match.homeGoals} - ${match.awayGoals}
      </p>

      <!-- Equipo visitante -->
      <p class="text-sm font-semibold text-gray-700 truncate text-center" title="${match.away}">
        ${match.away}
      </p>

      <!-- Estado y hora -->
      <p class="text-xs text-gray-500 mt-1 text-center">
        ${match.status} • ${match.time}
      </p>
    </div>
  `;
  };

  const renderError = (msg = "No se pudieron cargar los partidos") => {
    if (content)
      content.innerHTML = `<p class="text-xs text-red-600">${msg}</p>`;
    if (timeEl) timeEl.textContent = "";
  };

  const startCarousel = () => {
    if (intervalId) clearInterval(intervalId);
    if (matches.length === 0) return;
    renderMatch(matches[currentIndex]);
    intervalId = setInterval(() => {
      currentIndex = (currentIndex + 1) % matches.length;
      renderMatch(matches[currentIndex]);
    }, 4000);
  };
  const restartCarousel = () => {
    if (intervalId) clearInterval(intervalId);
    intervalId = setInterval(() => {
      currentIndex = (currentIndex + 1) % matches.length;
      renderMatch(matches[currentIndex]);
    }, 8000);
  };

  const nextMatch = () => {
    if (matches.length === 0) return;
    currentIndex = (currentIndex + 1) % matches.length;
    renderMatch(matches[currentIndex]);
    restartCarousel();
  };

  const prevMatch = () => {
    if (matches.length === 0) return;
    currentIndex = (currentIndex - 1 + matches.length) % matches.length;
    renderMatch(matches[currentIndex]);
    restartCarousel();
  };

  const refresh = async () => {
    try {
      const res = await fetchWithTimeout(API_URL, {
        headers: { Accept: "application/json" },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      matches = data.data || data; // soporta top/tournament
      writeCache(matches);
      currentIndex = 0;
      startCarousel();
      if (timeEl)
        timeEl.textContent = new Date().toLocaleTimeString("es-AR", {
          hour: "2-digit",
          minute: "2-digit",
        });
    } catch (e) {
      console.error(e);
      renderError();
    }
  };

  // Inicialización
  (async () => {
    const cached = readCache();
    if (cached) {
      matches = cached;
      startCarousel();
      setTimeout(refresh, 1000); // refresco de fondo
    } else {
      await refresh();
    }
  })();

  card?.addEventListener("click", (e) => {
    // Evita cambiar de partido si el usuario está seleccionando texto
    if (window.getSelection()?.toString()) return;

    if (e.shiftKey) {
      prevMatch();
    } else {
      nextMatch();
    }
  });
</script>
