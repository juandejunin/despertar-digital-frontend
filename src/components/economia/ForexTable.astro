---
import type {
  ForexGlobalResponse,
  MajorRates,
  LatinAmericaRates,
} from "@/lib/types";

const { data } = Astro.props as {
  data: ForexGlobalResponse;
};

const major: MajorRates = data.majorCurrencies;
const latam: LatinAmericaRates = data.latinAmerica;
---

<div class="bg-white rounded-lg shadow overflow-hidden w-full">
  <!-- Header -->
  <div class="bg-gradient-to-r from-green-600 to-green-700 text-white px-3 py-2">
    <h3 class="font-bold text-[13px] leading-tight">Forex Global</h3>
    <p class="text-[9px] opacity-90">Base {major.base}</p>
  </div>

  <!-- Tabla -->
  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead class="bg-green-600 text-white text-[11px]">
        <tr>
          <th class="px-2 py-1.5 text-left">Moneda</th>
          <th class="px-2 py-1.5 text-right">Tasa</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-200">
        {Object.entries(major)
          .filter(([k]) => !["base", "updated"].includes(k))
          .map(([code, value]) => (
            <tr class="hover:bg-gray-50 h-10">
              <td class="px-2 py-1 font-medium">{code}</td>
              <td class="px-2 py-1 text-right font-bold tabular-nums">
                {value}
              </td>
            </tr>
          ))}
      </tbody>
    </table>
  </div>

  <!-- LatAm -->
  <div class="border-t bg-gray-50">
    <div class="px-3 py-1 text-[10px] font-semibold text-gray-700">
      Latinoamérica
    </div>

    <table class="w-full text-xs">
      <tbody class="divide-y divide-gray-200">
        {Object.entries(latam)
          .filter(([k]) => !["base", "updated"].includes(k))
          .map(([code, value]) => (
            <tr class="hover:bg-gray-100 h-9">
              <td class="px-2 py-1 font-medium">{code}</td>
              <td class="px-2 py-1 text-right font-bold tabular-nums">
                {value}
              </td>
            </tr>
          ))}
      </tbody>
    </table>
  </div>

  <!-- Footer -->
  <div class="px-2 py-1 text-[8px] text-gray-500 text-center border-t">
    Fuente {data.provider} ·{" "}
    {new Date(data.timestamp).toLocaleTimeString("es-ES", {
      hour: "2-digit",
      minute: "2-digit",
    })}
  </div>
</div>
