---
import WeatherShowcase from "../islands/WeatherShowcase";
import LocationButtonIsland from "../islands/LocationButtonIsland";

const { apiUrl } = Astro.props;
const API_BASE = import.meta.env.PUBLIC_API_URL;
---

<div
  class="bg-white rounded-xl shadow-md p-5 border border-gray-100
         hover:shadow-lg transition-shadow
         flex flex-col w-full max-w-md min-h-[360px]"
>
  <!-- Header -->
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-lg font-bold text-gray-800">Clima Hoy</h3>
  </div>

  <!-- Contenido principal -->
  <div class="flex-1">
    <WeatherShowcase apiUrl={apiUrl} client:load />
  </div>

  <!-- Footer -->
  <div class="mt-4">
    <LocationButtonIsland apiBase={API_BASE} client:load />
  </div>
</div>
