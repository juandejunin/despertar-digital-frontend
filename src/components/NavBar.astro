---

<nav
  class="j75-nav fixed w-full bg-despertar-dark text-astro-white z-50 flex items-center justify-between p-6"
>
  <!-- Logo -->
  <div class="text-2xl font-bold font-inconsolata text-white">
    <a href="/"
      >Despertar Digital<span class="text-astro-primary-orange">.</span></a
    >
  </div>

  <!-- Ícono de hamburguesa personalizado -->

  <button
    id="j75-nav-toggle"
    class="md:hidden focus:outline-none relative z-[60] text-white"
    aria-label="Toggle menu"
  >
    <div class="hamburger-icon">
      <span class="line line1"></span>
      <span class="line line2"></span>
      <span class="line line3"></span>
    </div>
  </button>

  <!-- Overlay con transición -->
  <div
    id="overlay"
    class="fixed inset-0 bg-despertar-dark opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out z-40"
  >
  </div>

  <!-- Menú lateral -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 left-0 w-0 pt-14 bg-astro-primary-dark text-white text-xl transition-all duration-300 ease-in-out overflow-hidden md:hidden z-50"
  >
    <div class="p-4 flex flex-col">
      <ul class="space-y-4 mt-4 flex-grow min-w-full">
        <li>
          <a href="/" class="nav-link block hover:text-astro-secondary-light"
            >Inicio</a
          >
        </li>
        <li class="relative">
          <button
            class="nav-link w-full text-left hover:text-astro-secondary-light toggle-submenu"
          >
            Deportes
          </button>
          <ul class="hidden ml-4 mt-2 space-y-2 text-lg">
            <li>
              <a
                href="/deportes/futbol"
                class="nav-link block hover:text-astro-secondary-light"
              >
                Fútbol
              </a>
            </li>
            <li>
              <a
                href="/deportes/basquet"
                class="nav-link block hover:text-astro-secondary-light"
              >
                Básquet
              </a>
            </li>
            <li>
              <a
                href="/deportes/tenis"
                class="nav-link block hover:text-astro-secondary-light"
              >
                Tenis
              </a>
            </li>
          </ul>
        </li>

        <li class="relative">
          <button
            class="nav-link w-full text-left hover:text-astro-secondary-light toggle-submenu"
          >
            Economía
          </button>
          <ul class="hidden ml-4 mt-2 space-y-2 text-lg">
            <li>
              <a
                href="/economia/criptomonedas"
                class="nav-link block hover:text-astro-secondary-light"
                >Criptomonedas</a
              >
            </li>
            <li>
              <a
                href="/economia/forex"
                class="nav-link block hover:text-astro-secondary-light">Forex</a
              >
            </li>
            <li>
              <a
                href="/economia/dolar"
                class="nav-link block hover:text-astro-secondary-light">Dólar</a
              >
            </li>
            <li>
              <a
                href="/economia/oro"
                class="nav-link block hover:text-astro-secondary-light">Oro</a
              >
            </li>
            <li>
              <a
                href="/economia/petroleo"
                class="nav-link block hover:text-astro-secondary-light"
                >Petróleo</a
              >
            </li>
          </ul>
        </li>

        <li>
          <a
            href="/clima"
            class="nav-link block hover:text-astro-secondary-light">Clima</a
          >
        </li>
        <li>
          <a
            href="/contacto"
            class="nav-link block hover:text-astro-secondary-light">Contacto</a
          >
        </li>
      </ul>
    </div>
  </div>

  <!-- Menú desktop -->
  <ul class="hidden md:flex space-x-6 text-2xl text-white">
    <li>
      <a href="/" class="nav-link block hover:text-astro-secondary-light"
        >Inicio</a
      >
    </li>
    <li class="relative group">
      <button class="nav-link hover:text-astro-secondary-light cursor-pointer">
        Deportes
      </button>
      <ul
        class="absolute left-0 top-full mt-0 bg-black text-white rounded shadow-lg space-y-1 py-2
             opacity-0 invisible
             group-hover:opacity-100 group-hover:visible
             transition-opacity duration-200 z-50"
      >
        <li>
          <a
            href="/deportes/futbol"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Futbol</a
          >
        </li>
        <li>
          <a
            href="/deportes/basquet"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Basquet</a
          >
        </li>
        <li>
          <a
            href="/deportes/tenis"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Tenis</a
          >
        </li>
      </ul>
    </li>
    <li class="relative group">
      <button class="nav-link hover:text-astro-secondary-light cursor-pointer">
        Economía
      </button>
      <ul
        class="absolute left-0 top-full mt-0 bg-black text-white rounded shadow-lg space-y-1 py-2
             opacity-0 invisible
             group-hover:opacity-100 group-hover:visible
             transition-opacity duration-200 z-50"
      >
        <li>
          <a
            href="/economia/criptomonedas"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80"
            >Criptomonedas</a
          >
        </li>
        <li>
          <a
            href="/economia/forex"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Forex</a
          >
        </li>
        <li>
          <a
            href="/economia/dolar"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Dólar</a
          >
        </li>
        <li>
          <a
            href="/economia/oro"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Oro</a
          >
        </li>
        <li>
          <a
            href="/economia/petroleo"
            class="block px-4 py-1 hover:bg-astro-primary-dark/80">Petróleo</a
          >
        </li>
      </ul>
    </li>

    <li>
      <a href="/clima" class="nav-link block hover:text-astro-secondary-light"
        >Clima</a
      >
    </li>
    <li>
      <a
        href="/contacto"
        class="nav-link block hover:text-astro-secondary-light">Contacto</a
      >
    </li>
  </ul>
</nav>

<script>
  const menuToggle = document.getElementById("j75-nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("overlay");

  if (menuToggle && mobileMenu && overlay) {
    const openMenu = () => {
      menuToggle.classList.add("open");
      mobileMenu.classList.remove("w-0");
      mobileMenu.classList.add("w-3/4", "opacity-100");
      mobileMenu.classList.remove("overflow-hidden");
      mobileMenu.classList.add("overflow-auto");
      overlay.classList.remove("opacity-0");
      overlay.classList.remove("pointer-events-none");
      overlay.classList.add("opacity-100");
    };
    const closeMenu = () => {
      menuToggle.classList.remove("open");
      mobileMenu.classList.add("w-0", "opacity-0");
      mobileMenu.classList.remove("w-3/4", "opacity-100");
      mobileMenu.classList.add("overflow-hidden");
      mobileMenu.classList.remove("overflow-auto");
      overlay.classList.add("opacity-0");
      overlay.classList.add("pointer-events-none");
      overlay.classList.remove("opacity-100");

      // cerrar submenús
      document
        .querySelectorAll("#mobile-menu ul ul")
        .forEach((submenu) => submenu.classList.add("hidden"));
    };

    menuToggle.addEventListener("click", () => {
      const isOpen = mobileMenu.classList.contains("w-3/4");
      isOpen ? closeMenu() : openMenu();
    });

    overlay.addEventListener("click", closeMenu);

    // Submenús móviles
    document
      .querySelectorAll<HTMLButtonElement>("#mobile-menu .toggle-submenu")
      .forEach((btn) => {
        btn.addEventListener("click", () => {
          const submenu = btn.nextElementSibling as HTMLElement | null;
          submenu?.classList.toggle("hidden");
        });
      });

    // Submenús escritorio: click + teclado + transición suave
    document
      .querySelectorAll<HTMLButtonElement>(
        "nav > ul li.relative.group > button",
      )
      .forEach((button) => {
        const toggleSubmenu = (e: Event) => {
          if (window.innerWidth >= 768) {
            const submenu = button.nextElementSibling as HTMLElement | null;
            if (submenu) {
              e.preventDefault();
              // Toggle con transición suave
              if (submenu.classList.contains("opacity-0")) {
                submenu.classList.remove("opacity-0", "invisible");
                submenu.classList.add("opacity-100", "visible");
              } else {
                submenu.classList.remove("opacity-100", "visible");
                submenu.classList.add("opacity-0", "invisible");
              }
            }
          }
        };

        button.addEventListener("click", toggleSubmenu);

        button.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            toggleSubmenu(e);
          }
        });
      });

    // Listener de resize: cerramos submenús escritorio si se reduce ancho
    window.addEventListener("resize", () => {
      if (window.innerWidth < 768) {
        document
          .querySelectorAll<HTMLElement>("nav > ul li.relative.group > ul")
          .forEach((submenu) => {
            submenu.classList.remove("opacity-100", "visible");
            submenu.classList.add("opacity-0", "invisible");
          });
      }
    });

    // Listener para cambios de tamaño de ventana
    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        // Si el menú hamburguesa estaba abierto, cerrarlo
        if (mobileMenu.classList.contains("w-3/4")) {
          closeMenu();
        }

        // Reiniciar submenús móviles a estado oculto
        document
          .querySelectorAll("#mobile-menu ul ul")
          .forEach((submenu) => submenu.classList.add("hidden"));
      }
    });
  }
</script>

<style>
  #mobile-menu {
    top: 0;
    transition:
      width 0.4s ease,
      opacity 0.4s ease; /* transición suave de ancho y opacidad */
  }

  /* Estilos para las líneas del ícono de hamburguesa */
  #j75-nav-toggle .hamburger-icon .line {
    background-color: #fff; /* Usamos blanco directo ya que Tailwind no aplica aquí */
    height: 3px;
    margin: 4px 0;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    display: block;
  }

  #j75-nav-toggle .line1,
  #j75-nav-toggle .line2,
  #j75-nav-toggle .line3 {
    width: 25px;
    transform-origin: left center;
  }

  #j75-nav-toggle.open .line1 {
    transform: rotate(35deg);
  }

  #j75-nav-toggle.open .line2 {
    opacity: 0;
  }

  #j75-nav-toggle.open .line3 {
    transform: rotate(-35deg);
  }

  #overlay {
    transition: opacity 0.4s ease; /* transición más suave para el overlay */
  }

  /* Asegurar que el overlay sea clickable solo cuando esté visible */
  #overlay:not(.opacity-0) {
    pointer-events: auto;
  }
</style>
