---
import WeatherCard from "./WeatherCard.astro";
import DolarCard from "./DolarCard.astro";
import SportsCard from "./SportsCard.astro";

const TODAY_API = import.meta.env.PUBLIC_API_URL;
---

<section class="py-16 bg-gray-50 flex flex-wrap justify-center gap-6">
  <WeatherCard apiUrl={TODAY_API} />
  <DolarCard />
  <SportsCard />
</section>
