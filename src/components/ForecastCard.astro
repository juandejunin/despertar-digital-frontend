---
interface Props {
  time: string;
  description: string;
  temperature: number;
  feels_like: number;
  humidity: number;
  wind_speed: number;
  wind_deg: number;
}

const { time, description, temperature, feels_like, humidity, wind_speed, wind_deg } = Astro.props;

function getWindDirection(deg: number) {
  const dirs = ['N', 'NE', 'E', 'SE', 'S', 'SO', 'O', 'NO'];
  return dirs[Math.round(deg / 45) % 8];
}

function getBackground(description: string) {
  if (description.includes("claro")) return "from-blue-100 to-white";
  if (description.includes("nubes")) return "from-gray-100 to-white";
  return "from-indigo-100 to-white";
}
---

<div
  class={`bg-gradient-to-b ${getBackground(
    description
  )} rounded-2xl shadow-md hover:shadow-lg p-6 text-center transition-all duration-300 border border-gray-100`}
>
  <h3 class="text-xl font-semibold text-gray-800 mb-1">{time}</h3>
  <p class="text-gray-500 italic mb-4 capitalize">{description}</p>

  <div class="text-5xl font-bold text-blue-700 mb-2">{temperature.toFixed(1)}°C</div>
  <p class="text-sm text-gray-500 mb-5">Sensación {feels_like.toFixed(1)}°C</p>

  <div class="flex justify-center text-sm text-gray-600 space-x-4 border-t border-gray-200 pt-3">
    <span>💧 {humidity}%</span>
    <span>🌬️ {wind_speed.toFixed(1)} m/s</span>
    <span>🧭 {getWindDirection(wind_deg)}</span>
  </div>
</div>
