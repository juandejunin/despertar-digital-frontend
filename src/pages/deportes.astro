---
// src/pages/noticias.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Noticias y Deportes">

  <section class="py-16 px-4 max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-serif font-bold text-gray-900 mb-4">
        Noticias y Deportes
      </h2>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Explora las últimas tablas, goleadores y partidos en vivo.
      </p>
    </div>

    <!-- Grid de deportes -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Fútbol -->
      <a
        href="/futbol"
        class="group block bg-white rounded-xl shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden transform hover:-translate-y-1"
      >
        <div class="h-32 bg-gradient-to-br from-green-600 to-green-800 flex items-center justify-center">
          <span class="text-6xl group-hover:scale-110 transition-transform">Football</span>
        </div>
        <div class="p-6">
          <h3 class="text-2xl font-bold text-gray-900 mb-2">Fútbol</h3>
          <p class="text-gray-600">
            Tablas de posiciones, goleadores y partidos en vivo de las mejores ligas.
          </p>
          <span class="inline-block mt-4 text-green-600 font-semibold group-hover:text-green-700">
            Ir al fútbol Football
          </span>
        </div>
      </a>

      <!-- Placeholder para otros deportes -->
      <div class="bg-gray-50 rounded-xl p-8 flex flex-col items-center justify-center text-center border-2 border-dashed border-gray-300">
        <span class="text-5xl mb-4">Basketball</span>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Baloncesto</h3>
        <p class="text-gray-500 text-sm">Próximamente</p>
      </div>

      <div class="bg-gray-50 rounded-xl p-8 flex flex-col items-center justify-center text-center border-2 border-dashed border-gray-300">
        <span class="text-5xl mb-4">Tennis</span>
        <h3 class="text-xl font-semibold text-gray-700 mb-2">Tenis</h3>
        <p class="text-gray-500 text-sm">Próximamente</p>
      </div>

    </div>

    <!-- Mensaje en desarrollo -->
    <div class="mt-16 text-center">
      <p class="text-gray-500 italic">
        Esta sección está en desarrollo. Más deportes próximamente.
      </p>
    </div>
  </section>
</Layout>