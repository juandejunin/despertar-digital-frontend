---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.jsx";
---

<Layout>
  <section class="flex flex-col items-center justify-center text-center py-16">
    <h2 class="text-4xl font-serif font-bold text-gray-900 mb-6">Contacto</h2>
    <p class="text-gray-600 max-w-2xl mb-10 text-lg">
      Envíanos tu mensaje usando el formulario a continuación.
    </p>
    <ContactForm client:load />
  </section>
</Layout>
