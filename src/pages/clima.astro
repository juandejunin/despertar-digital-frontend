---
import Layout from "../layouts/Layout.astro";
import NavBar from "../components/NavBar.astro";
import ForecastCard from "../components/ForecastCard.astro";

interface WeatherLocation {
  ip: string;
  city: string;
  country: string;
}

interface ForecastItem {
  time: string;
  timestamp: number;
  description: string;
  temperature: number;
  feels_like: number;
  humidity: number;
  wind_speed: number;
  wind_deg: number;
}

interface WeatherData {
  location: WeatherLocation;
  city: string;
  forecast: ForecastItem[];
  today: boolean;
}

const API_URL = import.meta.env.PUBLIC_WEATHER_API_URL;

// 1. Datos iniciales desde servidor (fallback o IP del servidor)
let initialData: WeatherData | null = null;
let error = null;

try {
  const response = await fetch(API_URL);
  if (response.ok) {
    initialData = await response.json();
  }
} catch (e) {
  error = "Error al cargar datos iniciales";
  console.error(e);
}
---

<Layout>
  <NavBar />

  <section class="flex flex-col items-center py-16 bg-gradient-to-b from-gray-50 to-gray-100">
    <h2 id="city-title" class="text-4xl font-serif font-bold text-gray-900 mb-3">
      {initialData ? `Clima en ${initialData.city}` : "Cargando clima..."}
    </h2>

    <p class="text-gray-600 mb-12 text-lg">
      Pronóstico extendido para las próximas horas.
    </p>

    <div
      id="forecast-grid"
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 w-full max-w-7xl px-6"
      data-api-url={API_URL}
    >
      {initialData ? (
        initialData.forecast.map((item: ForecastItem) => (
          <ForecastCard
            time={item.time}
            description={item.description}
            temperature={item.temperature}
            feels_like={item.feels_like}
            humidity={item.humidity}
            wind_speed={item.wind_speed}
            wind_deg={item.wind_deg}
          />
        ))
      ) : (
        <div class="col-span-full text-center py-10">
          <span class="animate-pulse text-gray-500">Cargando pronóstico...</span>
        </div>
      )}
    </div>
  </section>
</Layout>

<script type="module">
  // === REUTILIZAMOS LA MISMA LÓGICA QUE EN WeatherBar ===
  // (Puedes incluso extraer esto a un archivo .ts/.js compartido)

  const API_URL = document.getElementById("forecast-grid")?.dataset.apiUrl;
  const cityTitle = document.getElementById("city-title");
  const grid = document.getElementById("forecast-grid");

  if (!API_URL || !grid || !cityTitle) return;

  const CACHE_TTL_MS = 5 * 60 * 1000;

  function getCityFromQuery() {
    try {
      const url = new URL(window.location.href);
      return url.searchParams.get("city")?.trim() || undefined;
    } catch {
      return undefined;
    }
  }

  function cacheKey(city) {
    return `weather-forecast:${city || "auto"}`;
  }

  function readCache(city) {
    const raw = sessionStorage.getItem(cacheKey(city));
    if (!raw) return null;
    try {
      const { ts, data } = JSON.parse(raw);
      if (Date.now() - ts < CACHE_TTL_MS) return data;
    } catch {}
    return null;
  }

  function writeCache(city, data) {
    sessionStorage.setItem(
      cacheKey(city),
      JSON.stringify({ ts: Date.now(), data })
    );
  }

  function formatNumber(n, digits = 0) {
    const num = Number(n);
    if (Number.isNaN(num)) return "—";
    return num.toLocaleString(undefined, {
      maximumFractionDigits: digits,
      minimumFractionDigits: digits,
    });
  }

  async function fetchWithTimeout(url, opts = {}, timeoutMs = 8000) {
    const controller = new AbortController();
    const id = setTimeout(() => controller.abort(), timeoutMs);
    try {
      return await fetch(url, { ...opts, signal: controller.signal });
    } finally {
      clearTimeout(id);
    }
  }

  function renderForecast(data) {
    if (!grid || !cityTitle) return;

    cityTitle.textContent = `Clima en ${data.city}`;

    grid.innerHTML = data.forecast
      .map(
        (item) => `
      <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition-shadow">
        <p class="text-sm font-medium text-gray-600">${item.time}</p>
        <p class="text-lg font-semibold capitalize">${item.description}</p>
        <p class="text-3xl font-bold text-blue-600">${Math.round(item.temperature)}°C</p>
        <p class="text-sm text-gray-500">Sensación: ${Math.round(item.feels_like)}°C</p>
        <p class="text-sm">💧 ${item.humidity}% • 💨 ${formatNumber(item.wind_speed, 1)} m/s</p>
      </div>
    `
      )
      .join("");
  }

  function renderLoading() {
    grid.innerHTML = `
      <div class="col-span-full text-center py-10">
        <span class="animate-pulse text-gray-500">Actualizando pronóstico...</span>
      </div>
    `;
  }

  function renderError(msg = "No se pudo cargar el pronóstico") {
    grid.innerHTML = `
      <div class="col-span-full text-center py-10">
        <span class="text-red-600 text-sm">${msg}</span>
      </div>
    `;
  }

  async function loadForecast() {
    const city = getCityFromQuery();
    const cached = readCache(city);

    if (cached) {
      renderForecast(cached);
      refreshInBackground(city);
      return;
    }

    renderLoading();

    try {
      const url = new URL(API_URL);
      if (city) url.searchParams.set("city", city);

      const res = await fetchWithTimeout(url.toString(), {
        headers: { Accept: "application/json" },
      });

      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      writeCache(city, data);
      renderForecast(data);
    } catch (e) {
      console.error(e);
      renderError();
    }
  }

  async function refreshInBackground(city) {
    try {
      const url = new URL(API_URL);
      if (city) url.searchParams.set("city", city);
      const res = await fetchWithTimeout(url.toString(), {
        headers: { Accept: "application/json" },
      });
      if (!res.ok) return;
      const data = await res.json();
      writeCache(city, data);
      renderForecast(data);
    } catch {}
  }

  // Iniciar carga en cliente
  loadForecast();
</script>