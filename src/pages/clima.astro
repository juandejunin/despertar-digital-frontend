---
// src/features/clima/pages/index.astro
import Layout from "../layouts/Layout.astro";  // sube 4 niveles
import WeatherCityTables from "../features/clima/components/WeatherCityTables";  // relativo a features/clima
import LocationButtonIsland from "../features/clima/islands/LocationButtonIsland";

const API_BASE = import.meta.env.PUBLIC_API_URL;
const forecastApi = `${API_BASE}/weather/forecast`;
---

<Layout title="El Tiempo - Despertar Digital">
  <section class="flex flex-col items-center justify-center text-center py-16">
    <h2 class="text-4xl font-serif font-bold text-gray-900 mb-6">
      El Tiempo
    </h2>
    <p class="text-gray-600 max-w-2xl mb-10 text-lg">
      Pronóstico actualizado para las principales ciudades de España.
    </p>

    <div class="flex justify-center mb-6">
      <LocationButtonIsland apiBase={API_BASE} client:load />
    </div>

    <div class="w-full max-w-5xl px-4">
      <WeatherCityTables client:load apiUrl={forecastApi} />
    </div>
  </section>
</Layout>