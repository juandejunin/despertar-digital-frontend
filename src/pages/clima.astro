---
// src/pages/clima.astro
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Tu ubicación</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-br from-blue-50 to-indigo-100 min-h-screen flex items-center justify-center">
  <div id="app" class="text-center p-8 bg-white rounded-xl shadow-lg">
    <p class="text-lg text-gray-600">Detectando tu ciudad...</p>
  </div>

  <script type="module">
    const app = document.getElementById("app");
    const { city } = await (await fetch("https://despertardigital.es/api/geo")).json();
    app.innerHTML = `<p class="text-3xl font-bold text-indigo-600">Tu ciudad: ${city}</p>`;
  </script>
</body>
</html>